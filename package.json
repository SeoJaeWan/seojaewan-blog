{
  "name": "seojaewan-blog",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.14.0",
  "engines": {
    "node": ">=24.0.0 <25.0.0"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "build:storybook": "turbo run build-storybook",
    "lint": "pnpm lint:js && pnpm lint:css",
    "lint:js": "eslint . --max-warnings=0 --cache --cache-location node_modules/.cache/eslint/",
    "lint:css": "stylelint \"**/*.css\" --max-warnings=0 --cache --cache-location node_modules/.cache/stylelint/",
    "typecheck": "turbo run typecheck && tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:e2e": "turbo run test:e2e",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "storybook": "turbo run storybook",
    "verify": "pnpm lint && pnpm typecheck && pnpm test",
    "prepare": "husky"
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.4",
    "@commitlint/config-conventional": "21.2.4",
    "@eslint/js": "9.39.5",
    "@next/eslint-plugin-next": "16.4.2",
    "@types/node": "24.19.2",
    "eslint": "9.39.5",
    "eslint-config-prettier": "10.1.8",
    "eslint-import-resolver-typescript": "4.4.5",
    "eslint-plugin-better-tailwindcss": "4.9.1",
    "eslint-plugin-boundaries": "7.2.0",
    "eslint-plugin-check-file": "3.3.2",
    "eslint-plugin-import-x": "4.17.1",
    "eslint-plugin-jsdoc": "65.3.12",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-simple-import-sort": "14.0.0",
    "eslint-plugin-storybook": "10.6.2",
    "globals": "17.13.0",
    "husky": "9.1.7",
    "lint-staged": "17.6.0",
    "prettier": "3.9.10",
    "prettier-plugin-tailwindcss": "0.8.1",
    "stylelint": "17.16.0",
    "tailwindcss": "4.3.3",
    "turbo": "2.11.9",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.2",
    "vitest": "5.0.5"
  }
}
