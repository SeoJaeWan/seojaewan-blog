{
  "name": "@seojaewan/design-system",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "exports": {
    ".": "./src/index.ts",
    "./story": "./src/story.ts",
    "./theme.css": "./src/theme.css"
  },
  "scripts": {
    "typecheck": "tsc --noEmit && tsc --noEmit -p scripts",
    "storybook": "storybook dev --port 6006 --no-open",
    "build-storybook": "storybook build",
    "test": "pnpm test:unit && pnpm test:storybook",
    "test:unit": "vitest run",
    "test:storybook": "vitest run --config vitest.storybook.config.ts",
    "generate:fonts": "node scripts/fonts/generate-fonts.ts",
    "generate:assets": "node scripts/assets/generate-assets.ts",
    "generate:tokens": "node scripts/tokens/generate-tokens.ts"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@storybook/addon-a11y": "10.6.6",
    "@storybook/addon-vitest": "10.6.6",
    "@storybook/react-vite": "10.6.6",
    "@tailwindcss/vite": "4.3.5",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "@vitest/browser-playwright": "5.1.0",
    "jsdom": "30.1.3",
    "playwright": "1.65.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "sharp": "0.35.5",
    "storybook": "10.6.6",
    "tailwindcss": "4.3.5",
    "typescript": "6.0.3",
    "vite": "8.3.8",
    "vitest": "5.1.0"
  },
  "dependencies": {
    "@base-ui/react": "1.9.0",
    "@fluentui/react-icons": "2.0.345",
    "@fontsource/nanum-gothic-coding": "5.3.0",
    "@fontsource/open-sans": "5.3.0",
    "clsx": "2.1.1",
    "pretendard": "1.3.9",
    "tailwind-merge": "3.7.0"
  }
}
