{
  "$schema": "https://turborepo.com/schema.json",
  "globalDependencies": ["tsconfig.base.json"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", "!e2e/**", "!**/*.test.{ts,tsx}", "!**/*.stories.tsx"],
      "outputs": [".next/**", "!.next/cache/**", "dist/**"],
      "env": ["CONTENT_SOURCE"],
      "passThroughEnv": ["NOTION_TOKEN"]
    },
    "build-storybook": {
      "outputs": ["storybook-static/**"]
    },
    "typecheck": {
      "dependsOn": ["^typecheck"]
    },
    "test:e2e": {
      "dependsOn": ["build"],
      "passThroughEnv": ["CI", "PLAYWRIGHT_*", "E2E_PORT", "CONTENT_SOURCE"],
      "cache": false
    },
    "dev": {
      "cache": false,
      "persistent": true,
      "passThroughEnv": [
        "CONTENT_SOURCE",
        "NOTION_TOKEN",
        "NOTION_WEBHOOK_SECRET",
        "ALERT_URL",
        "ALERT_SECRET"
      ]
    },
    "storybook": {
      "cache": false,
      "persistent": true
    }
  }
}
