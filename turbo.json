{
  "$schema": "https://turbo.build/schema.json",
  "ui": "tui",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**", "storybook-static/**"]
    },
    "clean": {
      "cache": false
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "@window/ui#build": {
      "dependsOn": [],
      "outputs": ["dist/**"]
    },
    "@window/ui#dev:web": {
      "cache": false,
      "dependsOn": ["@window/ui#build"],
      "persistent": true
    },
    "@window/shell#typecheck": {
      "dependsOn": ["@window/ui#build"],
      "outputs": []
    },
    "@window/web#dev:web": {
      "cache": false,
      "dependsOn": ["@window/ui#build"],
      "persistent": true
    },
    "format:check": {
      "outputs": []
    },
    "lint": {
      "dependsOn": ["^lint"],
      "outputs": []
    },
    "test": {
      "dependsOn": ["^build"],
      "outputs": ["coverage/**"]
    },
    "typecheck": {
      "dependsOn": ["^typecheck"],
      "outputs": []
    }
  }
}
