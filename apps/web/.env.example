# 값은 저장소에 두지 않는다. apps/web/.env.local로 옮겨 값을 넣는다.
# 글을 읽는 곳: notion(기본) 또는 fixture
CONTENT_SOURCE=
# seojaewan-blog 연동 토큰. CONTENT_SOURCE가 notion이면 필수다
NOTION_TOKEN=
# Notion 웹훅 서명 검증 비밀값(seojaewan-blog 연동 웹훅의 확인 토큰). 없으면 웹훅 라우트가 갱신 요청을 모두 거절한다
NOTION_WEBHOOK_SECRET=
# 알림 서비스 notify 주소(http://10.88.0.1:8790/notify). 없으면 알림을 보내지 않는다
ALERT_URL=
# notify의 blog 서비스 비밀값. 사람이 넣지 않고 배포 때 젠킨스가 파일에서 읽어 넣는다
ALERT_SECRET=
