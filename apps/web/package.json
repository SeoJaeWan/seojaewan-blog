{
  "name": "@seojaewan/web",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "next typegen && tsc --noEmit",
    "test:e2e": "playwright test",
    "storybook": "storybook dev --port 6007 --no-open",
    "build-storybook": "storybook build",
    "test": "pnpm test:unit && pnpm test:storybook",
    "test:unit": "vitest run",
    "test:storybook": "vitest run --config vitest.storybook.config.ts",
    "fetch:notion-fixture": "node --conditions=react-server scripts/fetch-notion-fixture.ts",
    "export:notion-content": "node --conditions=react-server --import ./scripts/app-alias-hooks.ts scripts/export-notion-content.ts",
    "generate:og-default": "node scripts/generate-og-default.ts"
  },
  "dependencies": {
    "@base-ui/react": "1.9.0",
    "@seojaewan/design-system": "workspace:*",
    "katex": "0.19.1",
    "next": "16.4.6",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "server-only": "0.0.1",
    "shiki": "4.6.0",
    "zod": "4.6.7",
    "zustand": "5.1.0"
  },
  "devDependencies": {
    "@playwright/test": "1.65.0",
    "@storybook/addon-a11y": "10.6.7",
    "@storybook/addon-vitest": "10.6.7",
    "@storybook/react-vite": "10.6.7",
    "@tailwindcss/postcss": "4.3.5",
    "@tailwindcss/vite": "4.3.5",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "@vitest/browser-playwright": "5.1.0",
    "babel-plugin-react-compiler": "1.0.0",
    "jsdom": "30.1.3",
    "playwright": "1.65.0",
    "storybook": "10.6.7",
    "tailwindcss": "4.3.5",
    "typescript": "6.0.3",
    "vite": "8.3.8",
    "vitest": "5.1.0"
  }
}
