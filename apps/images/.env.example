# 값은 저장소에 두지 않는다. 로컬에서는 apps/images/.env.local로 옮겨 값을 넣는다(`pnpm start`가 읽는다).
# 운영 컨테이너에는 젠킨스가 비밀값을 넣는다(루트 compose.yaml, deploy/deploy-changed.mjs).
# seojaewan-images 연동 토큰(읽기 전용). 반드시 있어야 한다
NOTION_TOKEN=
# 이미지를 저장할 폴더. 기본 /srv/seojaewan-blog/images
IMAGE_STORE_DIR=
# 들을 주소. 기본 127.0.0.1, 컨테이너는 0.0.0.0
HOST=
# 들을 포트. 기본 3100
PORT=
# notify 주소와 클라이언트 images의 비밀값. 둘은 함께 넣거나 함께 비운다. 비우면 알림을 로그로만 남긴다
ALERT_URL=
ALERT_SECRET=
